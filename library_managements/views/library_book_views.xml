<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books">
                <field name="name"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>

    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Book name"/></h1>
                    </div>
                    <group>
                        <field name="is_available" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="borrowing_history" string="Borrowing History">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="member_id"/>
                                    <field name="borrow_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_book_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Books">
                <field name="name"/>
                <filter name="available" string="Available"
                        domain="[('is_available', '=', True)]"/>
                <filter name="borrowed" string="Borrowed"
                        domain="[('is_available', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_book_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first book.</p>
            <p>Each record represents one physical book that can be borrowed.</p>
        </field>
    </record>
</odoo>
