<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_book_report" model="ir.actions.report">
        <field name="name">Book Borrowing Report</field>
        <field name="model">library.borrow</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.report_book_borrow_document</field>
        <field name="report_file">library_management.report_book_borrow_document</field>
        <field name="print_report_name">'Book Borrowing Report -%s' %(object.name)</field>
        <field name="binding_model_id" ref="model_library_borrow" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_book_borrow_document">
        <t t-call="web.html_container">
            <t t-set="company" t-value="res_company"/>
                <t t-foreach="docs" t-as="o">
                    <!-- Header -->
                    <div class="header">
                        <div class="d-flex justify-content-between  align-items-center border-bottom pb-2">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 45px;" alt="Logo" />
                            <h3 class="text-center fw-bold" t-esc="company.name" />
                        </div>
                        <div class="text-center mt-4">
                            <h5 class="text-center fw-bold">Book Borrowing Report</h5>
                        </div>
                    </div>
                    <!-- Body -->
                    <div class="article" t-att-data-oe-id="o._name" t-att-data-oe-model="o.id" t-att-data-oe-lang="o.env.context.get('lang')">
                        <div class="page">
                            <div style="border: 1.5px solid #333;margin-top:100px;border:none !important;">
                                <table class="table table-borderless"  style="width: 100%; border-spacing: 0;">
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Member</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.member_id.name"/>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Member Code</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.member_code_id"/>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Book</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.book_id"/>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Borrow Date</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.borrow_date"/>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Due Date</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.due_date"/>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="height: 36px;">
                                        <td style="width: 25%; font-weight: bold; vertical-align: middle; padding: 6px 0 6px 25px;">Status</td>
                                        <td style="width: 3%; text-align: center; font-weight: bold; vertical-align: middle; padding: 6px 0;">:</td>
                                        <td style="width: 72%; vertical-align: middle; padding: 6px 20px 6px 10px;">
                                            <div style="margin-left: 160px;">
                                                <span t-field="o.state"/>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="footer">
                        <div class="row" style="border-top: 1px solid black; padding-top: 5px;">
                            <div class="col-8 text-start">
                                <span>Book Borrow Report</span>
                            </div>
                            <div class="col-4 text-end">
                                Page: <span class="page"/> / <span class="topage"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </odoo>