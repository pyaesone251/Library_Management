<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Book Form View -->
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Library Book">
                <header>
                    <button name="action_available" string="Available" type="object" class="btn btn-outline-success" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,borrowed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="book_code" />
                        </h2>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <group>
                        <group string="Book Information">
                            <field name="book_name"/>
                            <field name="isbn" />
                            <field name="author_ids" widget="many2many_tags" />
                            <field name="author" invisible="1" />
                            <field name="published_date" />
                        </group>
                        <group string="Stock &amp; Price">
                            <field name="price"/>
                            <field name="available_copies" />
                            <field name="active" />
                            <field name="category_id" />                            
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Book List View -->
     <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_name"/>
                <field name="isbn" />
                <field name="author_ids" widget="many2many_tags" />
                <field name="published_date" />
                <field name="price" />
                <field name="available_copies" />
                <field name="category_id" />
                <field name="state" widget="badge"  decoration-info="state =='draft'"
                                                    decoration-success="state == 'available'"
                                                    decoration-warning="state == 'borrowed'" />
            </list>
        </field>
     </record>

    <!-- Book Action -->
    <record id="action_book_view" model="ir.actions.act_window">
        <field name="name">Library Book</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new Book
            </p>
        </field>
    </record>
</odoo>