<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_category_form" model="ir.ui.view">
        <field name="name">category.form</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_count" string="Count" type="object" class="btn btn-outline-info"/>
                    <button name="action_price" string="Price" type="object" class="btn btn-outline-info" />
                </header> 
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="author" />
                                    <field name="price" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_category_list" model="ir.ui.view">
        <field name="name">category.list</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first record
            </p>
        </field>
    </record>

    <menuitem id="library_management_menu_root" name="Library Management" sequence="10"/>
    <menuitem id="library_category_menu" name="Category" parent="library_management_menu_root" action="action_category" sequence="20" />
</odoo>