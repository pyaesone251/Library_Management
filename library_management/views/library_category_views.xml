<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_library_category_list" model="ir.ui.view">
        <field name="name">library.category.list</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <!-- <field name="book_ids" widget="" /> -->
            </list>
        </field>
    </record>

    <record id="view_library_category_form" model="ir.ui.view">
        <field name="name">library.category.form</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="book_count" />
                            <field name="cheap_book_count" />
                            <field name="total_book_price" />
                        </group>
                        <group>
                            <button name="action_count" string="Count" type="object" class="btn btn-primary"/>
                            <button name="action_increase_all_price" string="Price Change" type="object" class="btn btn-primary" />
                            <button name="action_filter" string="Filter" type="object" class="btn btn-primary" /> 
                            <button name="action_show_name" string="Show Name" type="object" class="btn btn-primary" />
                            <button name="action_sort_book_price" string="Sort by price" type="object" class="btn btn-primary" />
                            <button name="action_sort" string="Sort" type="object" class="btn btn-primary" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="author" />
                                    <field name="price" />
                                    <field name="category_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_category" model="ir.actions.act_window">
        <field name="name">Library Category</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create you are record
            </p>
        </field>
    </record>

    <menuitem id="library_management_menu_root" name="Library" sequence="10"/>
    <menuitem id="library_category_menu" name="Category" sequence="20" parent="library_management_menu_root" action="action_category" /> 
</odoo>